# 개인 로컬 설정 예시 파일.
#
# 사용법:
#   1. 이 파일을 같은 폴더에 local.yml 이라는 이름으로 복사
#   2. api-key 에 본인이 발급받은 키를 붙여넣기
#   3. 서버 재시작
#
# local.yml 은 .gitignore 에 등록되어 있어 깃허브에 올라가지 않는다.
# 팀원 각자 자기 키를 넣으면 되고, 서로의 키를 공유할 필요가 없다.
#
# Gemini 무료 키 발급: https://aistudio.google.com/apikey
# (Google 계정만 있으면 되고 카드 등록은 필요 없다)

llm:
  # 발급받은 키로 교체. AIza 로 시작하는 39자 내외의 문자열이다.
  api-key: "여기에_발급받은_키를_붙여넣으세요"

  # 아래는 기본값이라 보통 건드릴 필요 없다.
  # provider: gemini          # gemini | mock  (mock = 키 없이 가짜 응답으로 테스트)
  # model: gemini-flash-latest
  # timeout-seconds: 20
